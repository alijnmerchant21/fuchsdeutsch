# Leave these empty to run in demo mode (progress saved in the browser only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Custom domain for login redirects (keeps sessions on www, not *.vercel.app).
NEXT_PUBLIC_SITE_URL=https://www.fuchsdeutsch.de

# Only needed for `npm run audio` (never exposed to the browser).
ELEVENLABS_API_KEY=
# Optional. Default eleven_v3 (most natural). eleven_multilingual_v2 is steadier if v3 sounds off.
ELEVENLABS_MODEL=
